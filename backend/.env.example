# ============================================================
# SISTEMA DE CONTROL ACADÉMICO - Centro Escolar San Francisco de Asís
# Variables de entorno del Backend
#
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo como .env
# 2. Rellena los valores según tu entorno
# 3. NUNCA subas el archivo .env a GitHub
# ============================================================

# --- Base de Datos ---
DB_HOST=localhost        # Host de MySQL (usar 'mysql' si usas Docker)
DB_PORT=3306             # Puerto de MySQL
DB_NAME=sca_db           # Nombre de la base de datos
DB_USER=root             # Usuario de MySQL
DB_PASS=                 # Contraseña de MySQL (vacío en XAMPP por defecto)

# --- JWT (JSON Web Tokens) ---
# Genera un secreto seguro con: openssl rand -base64 64
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRATION=86400     # Tiempo en segundos (86400 = 24 horas)

# --- Aplicación ---
APP_ENV=development      # development | production
CORS_ORIGINS=http://localhost:8081